projection;
strict ( 2 );

use draft;
use side effects;


define behavior for ZAP_C_SO_HEADER
{

  use create;
  use update;
  use delete;

  use action Approve;
  use action Reject;
  use action Cancel;
  use action Dispatch;
  use action GenerateInvoice;
  use action RecordPayment;

  use association _Items { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

}

define behavior for ZAP_C_SO_ITEM
use etag
{



  use update;
  use delete;

  use association _SalesOrder { with draft; }

}