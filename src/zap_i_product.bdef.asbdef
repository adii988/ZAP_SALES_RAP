managed implementation in class zbp_ap_i_product unique;
strict ( 2 );
with draft;

define behavior for ZAP_I_PRODUCT
persistent table zap_product
draft table zap_product_d
lock master total etag ChangedAt
authorization master ( instance )
etag master ChangedAt
early numbering
{

  create;
  update;
  delete;

  field ( readonly )
  ProductId,
  ChangedAt,
  ChangedBy;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;


  draft determine action Prepare
  {
    validation ValidateUnitPrice;
    validation ValidateStock;
    validation ValidateDuplicateProduct;
  }



  validation ValidateUnitPrice
  on save { create; update; }

  validation ValidateStock
  on save { create; update; }

  validation ValidateDuplicateProduct
  on save { create; update; }



  mapping for zap_product corresponding
    {
      ProductId   = product_id;
      ProductName = product_name;
      Category    = category;
      Brand       = brand;
      UnitPrice   = unit_price;
      Currency    = currency;
      StockQty    = stock_qty;
      ChangedAt   = lastchangedat;
      ChangedBy   = localchangedby;
    }

}