@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName       : 'Sales Order Item',
  typeNamePlural : 'Sales Order Items',
  title          : { type: #STANDARD, value: 'ItemNo' },
  description    : { type: #STANDARD, value: 'ProductId' }
}

annotate entity ZAP_C_SO_ITEM
with
{

  @UI.facet: [
    {
      id       : 'ItemInfo',
      type     : #IDENTIFICATION_REFERENCE,
      label    : 'Item Information',
      position : 10
    }
  ]

  @UI.lineItem:       [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10,label:'Item Number' }]
  ItemNo;

  @UI.lineItem:       [{ position: 20, importance: #HIGH }]
  @UI.identification: [{ position: 20,label: 'Product ID' }]
  @UI.selectionField: [{ position: 10 }]
  ProductId;

  @UI.lineItem:       [{ position: 30 }]
  @UI.identification: [{ position: 30,label:'Quantity' }]
  Quantity;

  @UI.lineItem:       [{ position: 40 }]
  @UI.identification: [{ position: 40,label:'Unit Price' }]
  UnitPrice;

  @UI.lineItem:       [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ position: 50,label : 'Line Amount' }]
  LineAmount;

}